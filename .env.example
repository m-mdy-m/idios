# IDIOS needs no API keys and makes no network calls. These are optional.

# Where IDIOS keeps idios.db, history and exports (default: ~/.idios)
# IDIOS_HOME=~/.idios

# Colour: auto (default) | always | never.  NO_COLOR=1 also disables it.
# IDIOS_COLOR=auto

# Show Python tracebacks instead of friendly errors
# IDIOS_DEBUG=1
