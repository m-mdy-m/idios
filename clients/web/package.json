{
  "name": "@idios/clients/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite --host 127.0.0.1",
    "check:reading-skills": "node scripts/check-reading-skills.mjs",
    "build": "node scripts/check-feature-boundaries.mjs && node scripts/check-service-boundaries.mjs && node scripts/check-reading-skills.mjs && node --experimental-strip-types scripts/check-study-actions.mjs && node --experimental-strip-types scripts/check-reader-translation.mjs && node scripts/copy-pdfjs-assets.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "check:architecture": "node scripts/check-feature-boundaries.mjs && node scripts/check-service-boundaries.mjs",
    "check:study-actions": "node --experimental-strip-types scripts/check-study-actions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15",
    "pdfjs-dist": "^5.4.394"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
